-- // Função Tween
local function Tween(obj, props, dur)
    return TS:Create(obj, TweenInfo.new(dur or 0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

-- // Notificação
local function Notify(title, msg)
    spawn(function()
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 250, 0, 60)
        frame.Position = UDim2.new(1, -260, 0, 10)
        frame.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        frame.BorderSizePixel = 0
        frame.Parent = gui
        
        Instance.new("UIStroke", frame).Color = Color3.fromRGB(180, 0, 0)
        Instance.new("UIStroke", frame).Thickness = 1
        
        local t = Instance.new("TextLabel", frame)
        t.Size = UDim2.new(1, -10, 0, 20)
        t.Position = UDim2.new(0, 5, 0, 5)
        t.BackgroundTransparency = 1
        t.Text = title
        t.TextColor3 = Color3.fromRGB(255, 50, 50)
        t.Font = Enum.Font.Code
        t.TextSize = 12
        t.TextXAlignment = Enum.TextXAlignment.Left
        
        local m = Instance.new("TextLabel", frame)
        m.Size = UDim2.new(1, -10, 0, 30)
        m.Position = UDim2.new(0, 5, 0, 25)
        m.BackgroundTransparency = 1
        m.Text = msg
        m.TextColor3 = Color3.fromRGB(180, 180, 180)
        m.Font = Enum.Font.Code
        m.TextSize = 10
        m.TextXAlignment = Enum.TextXAlignment.Left
        m.TextWrapped = true
        
        Tween(frame, {BackgroundTransparency = 0.2}, 0.3)
        task.wait(3)
        Tween(frame, {BackgroundTransparency = 1, Position = UDim2.new(1, 0, 0, 10)}, 0.3)
        task.wait(0.3)
        frame:Destroy()
    end)
end

