-- // Sistema de Páginas
local pages = {}
local buttons = {}
local active = nil

local function CreateTab(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, 34)
    btn.Position = UDim2.new(0, 3, 0, 0)
    btn.Text = "> " .. name
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
    btn.Font = Enum.Font.Code
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = nav
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(35, 35, 35)
    btnStroke.Thickness = 1
    
    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -10, 1, -10)
    page.Position = UDim2.new(0, 5, 0, 5)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 2
    page.ScrollBarImageColor3 = Color3.fromRGB(180, 0, 0)
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.BorderSizePixel = 0
    page.Parent = content
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 5)
    layout.Parent = page
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)
    
    btn.MouseButton1Click:Connect(function()
        if active == page then return end
        active = page
        
        for _, p in pairs(pages) do p.Visible = false end
        for _, b in pairs(buttons) do
            Tween(b, {BackgroundColor3 = Color3.fromRGB(18, 18, 18), TextColor3 = Color3.fromRGB(150, 150, 150)}, 0.2)
            if b:FindFirstChildOfClass("UIStroke") then
                Tween(b:FindFirstChildOfClass("UIStroke"), {Color = Color3.fromRGB(35, 35, 35)}, 0.2)
            end
        end
        
        page.Visible = true
        Tween(btn, {BackgroundColor3 = Color3.fromRGB(40, 5, 5), TextColor3 = Color3.fromRGB(255, 50, 50)}, 0.2)
        Tween(btnStroke, {Color = Color3.fromRGB(180, 0, 0)}, 0.2)
    end)
    
    btn.MouseEnter:Connect(function()
        if active ~= page then
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(25, 25, 25), TextColor3 = Color3.fromRGB(200, 200, 200)}, 0.15)
        end
    end)
    btn.MouseLeave:Connect(function()
        if active ~= page then
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(18, 18, 18), TextColor3 = Color3.fromRGB(150, 150, 150)}, 0.15)
        end
    end)
    
    table.insert(pages, page)
    table.insert(buttons, btn)
    return page
end

local function AddButton(page, text, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Text = ">> " .. text
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.Font = Enum.Font.Code
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = page
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(40, 40, 40)
    btnStroke.Thickness = 1
    
    btn.MouseEnter:Connect(function()
        Tween(btn, {BackgroundColor3 = Color3.fromRGB(30, 10, 10)}, 0.15)
        Tween(btnStroke, {Color = Color3.fromRGB(180, 0, 0)}, 0.15)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, {BackgroundColor3 = Color3.fromRGB(20, 20, 20)}, 0.15)
        Tween(btnStroke, {Color = Color3.fromRGB(40, 40, 40)}, 0.15)
        btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    end)
    btn.MouseButton1Click:Connect(function()
        Tween(btn, {BackgroundColor3 = Color3.fromRGB(60, 20, 20)}, 0.1)
        task.wait(0.1)
        Tween(btn, {BackgroundColor3 = Color3.fromRGB(30, 10, 10)}, 0.2)
        callback()
    end)
    
    return btn
end

